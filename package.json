{
  "name": "directory-indexer",
  "version": "1.0.0",
  "description": "AI-powered directory indexing with semantic search for MCP servers",
  "main": "dist/cli.js",
  "bin": {
    "directory-indexer": "bin/directory-indexer.js"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests --exclude \"tests/integration/**\" --exclude \"tests/integration.test.ts\"",
    "test:integration": "vitest run tests/integration/",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "cli": "node bin/directory-indexer.js"
  },
  "keywords": [
    "mcp",
    "search",
    "indexing",
    "ai",
    "semantic",
    "cli"
  ],
  "author": "Peter Etelej <peter@etelej.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peteretelej/directory-indexer.git"
  },
  "homepage": "https://github.com/peteretelej/directory-indexer",
  "bugs": {
    "url": "https://github.com/peteretelej/directory-indexer/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "ignore": "^7.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
